# ----------------------------------------------------
# LearnHUB Server Environment Configuration Template
# ----------------------------------------------------

# Runtime Environment (development | production | test)
NODE_ENV=development
PORT=4000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/learnhub

# Frontend Client URLs (CORS allowed origins)
CLIENT_URL=http://localhost:5173
ADMIN_CLIENT_URL=http://localhost:5174

# Authentication & Security
JWT_SECRET=replace-with-a-secure-random-secret-key-at-least-32-chars
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# SMTP Transactional Email Service
# In development, if SMTP_USER is blank, verification codes and reset links are safely logged to console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LearnHUB <no-reply@learnhub.et>"

# Initial Super Admin Bootstrapping
ADMIN_EMAIL=admin@learnhub.et
ADMIN_PASSWORD=change-this-secure-admin-password
SEED_DEMO_DATA=false

# Cloud Storage (Optional S3 / Cloudflare R2 / MinIO for production object storage)
# If unconfigured, the platform stores uploads safely in local persistent storage.
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=learnhub-storage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Google Calendar & Meet API (Optional OAuth Integration)
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
